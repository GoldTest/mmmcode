{
  "name": "waygate-mmcode",
  "version": "0.6.1",
  "description": "MiniMax Code 本地反代：官方 OAuth 设备授权登录，提供原生 Anthropic 兼容端点（/v1/messages 与 /v1/messages/count_tokens）",
  "keywords": [
    "minimax",
    "minimax-code",
    "mmcode2api",
    "reverse-proxy",
    "anthropic",
    "claude-code",
    "count-tokens",
    "checkin",
    "credits"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoldTest/mmmcode.git"
  },
  "homepage": "https://github.com/GoldTest/mmmcode#readme",
  "bugs": {
    "url": "https://github.com/GoldTest/mmmcode/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mmcode": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-web.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "node --experimental-strip-types src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "waygate-core": "^0.2.8"
  }
}
