node_modules/
*.log
.DS_Store

# 打包产物（npm pack 的临时物，绝不入库）
*.tgz

# 构建产物（dist/ 由 npm run build 生成，镜像与 npm 包都在 CI 里从源码构建）
# —— 不入库：产物随代码漂移会污染 diff，且版本由 Git tag 管理，产物无需追溯。
dist/

# 本地状态与密钥（管理密钥、令牌绝不进版本库）
.env
.env.*
!.env.example
*.local.json

# 测试与覆盖率
coverage/
.vitest/
*.tsbuildinfo

# 本地 AI 技能包的临时区
# —— 不入库：.agents/_tmp/ 是抓取技能时克隆的第三方仓库（1.6MB 起步），
#    随下载更新即可，保留它只会污染 git diff。
#    注意：.agents/skills/ 下的技能本体是要入库的，它是项目资产。
.agents/_tmp/
