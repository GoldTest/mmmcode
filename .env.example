# Docker 编排用的本机参数 —— 复制成 .env 后按本机情况改。
#
#   cp .env.example .env
#
# setup 脚本会自动生成 .env（填好本机的 uid/gid 与状态目录）。

# 容器以宿主用户身份运行 —— 绑定挂载的状态目录归宿主机所有，
# 容器内的默认用户（uid 100）写不进去。用 id -u / id -g 的结果。
WAYGATE_UID=1000
WAYGATE_GID=1000

# 状态目录：容器与宿主机共用同一份凭证。
# ⚠️ 不要用命名卷 —— refresh token 是一次性的，有两份拷贝会互相顶掉。
WAYGATE_STATE=/home/yourname/.waygate
